# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_xxx

# Payment Processing
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx

# Email Services - Resend (just these two!)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Contentpreneur Hub <hello@contentpreneurhub.online>

# Optional: Specific Resend audience (uses default if not set)
# RESEND_AUDIENCE_ID=aud_xxx

# Cron Job Security
CRON_SECRET=your_cron_secret_here

# Analytics (Optional)
GA4_MEASUREMENT_ID=G-xxx
FACEBOOK_PIXEL_ID=xxx

# App URL (set automatically by Vercel)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
