# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_xxx

# Payment Processing
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx

# Email Services
RESEND_API_KEY=re_xxx

# Email Marketing - ConvertKit (Optional but recommended)
CONVERTKIT_API_KEY=xxx
CONVERTKIT_API_SECRET=xxx
CONVERTKIT_FORM_ID=123456

# ConvertKit Sequences (get IDs from ConvertKit dashboard)
CONVERTKIT_SEQUENCE_WELCOME=123456
CONVERTKIT_SEQUENCE_ABANDONED=123457

# ConvertKit Tags (get IDs from ConvertKit dashboard)
CONVERTKIT_TAG_PURCHASED=123456
CONVERTKIT_TAG_ACTIVE=123457
CONVERTKIT_TAG_MODULE1_COMPLETE=123458
CONVERTKIT_TAG_ENGAGED=123459
CONVERTKIT_TAG_ALL_COMPLETE=123460
CONVERTKIT_TAG_ABANDONED_CART=123461

# Analytics (Optional)
GA4_MEASUREMENT_ID=G-xxx
FACEBOOK_PIXEL_ID=xxx

# App URL (set automatically by Vercel)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
